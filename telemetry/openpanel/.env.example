# Development configuration for the self-hosted OpenPanel instance.
# Copy this file to ".env" and adjust the values before running
# "docker compose up -d".
# WARNING: the secrets below are development placeholders, do not reuse them
# outside of a local development machine.

NODE_ENV="production"
SELF_HOSTED="true"
AUTOMATIC_MIGRATIONS="true"
BATCH_SIZE="5000"
BATCH_INTERVAL="10000"

# Development instance: allow creating the first admin account from the
# dashboard at http://localhost:8080
ALLOW_REGISTRATION="true"
ALLOW_INVITATION="true"

REDIS_URL="redis://op-kv:6379"
CLICKHOUSE_URL="http://op-ch:8123/openpanel"
DATABASE_URL="postgresql://postgres:postgres@op-db:5432/openpanel"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@op-db:5432/openpanel"

# Public URLs of the dev instance (caddy is bound to 127.0.0.1:8080)
DASHBOARD_URL="http://localhost:8080"
API_URL="http://localhost:8080/api"
API_URL_SSR="http://op-api:3000"

# Secrets: replace with your own generated values, e.g.
#   openssl rand -base64 32
COOKIE_SECRET="dev-cookie-secret-change-me"
AUTH_SECRET="dev-auth-secret-change-me"
ENCRYPTION_KEY="dev-encryption-key-change-me"

# Basic auth for the operator-only surfaces (queue dashboard at /bullboard)
ADMIN_USERNAME="dev-admin"
ADMIN_PASSWORD="dev-password"

# No email server in development: emails are logged to the container console
EMAIL_SENDER=""
RESEND_API_KEY=""

# Events go through the bundled Redpanda (Kafka compatible) service
KAFKA_BROKERS="op-rp:9092"
KAFKA_EVENTS_TOPIC_PARTITIONS="1"

# Avoid outbound calls from the dev instance
DISABLE_PING="true"
DISABLE_FAVICON_FETCH="true"
